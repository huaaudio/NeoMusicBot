mvnw text eol=lf
mvnw.cmd text eol=crlf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
# Preserve byte-for-byte hashes of captured upstream license documents.
src/license/provider/*.txt -text
src/license/canvas/windows/*.txt -text
src/license/canvas/librsvg-rust/* -text
src/license/canvas/linux-librsvg-rust/* -text
# Build input hashes must be identical in Windows and Linux checkouts.
src/provider-runtime/native-linux/* -text
